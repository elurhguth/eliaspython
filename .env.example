# ─────────────────────────────────────────────────────────────
#  Crew – configuration. Copy to .env and fill in.
#  Generate secrets with:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────

# Address of your instance as seen in the browser (used for passkeys + cookies).
PUBLIC_URL=http://localhost:8080

# Caddy: ":80" = plain HTTP on HTTP_PORT. Set a domain (crew.example.com) for automatic HTTPS
# and then use HTTP_PORT=80 / HTTPS_PORT=443.
CREW_SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# Secrets (REQUIRED)
POSTGRES_PASSWORD=change-me-long-random
WORKSTATION_TOKEN=change-me-long-random-at-least-16-chars
SEARXNG_SECRET=change-me

# Optional: create the login user automatically on first start
# (otherwise you create it in the browser the first time you open Crew).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Models (add at least one) ─────────────────────────────────
# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-opus-5-5
# Server-side refusal fallback for Claude Opus 5.x/Fable/Sonnet 5.5 (recommended)
ANTHROPIC_REFUSAL_FALLBACK=true

# xAI (Grok) – OpenAI-compatible API
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_DEFAULT_MODEL=grok-4

# Any other OpenAI-compatible endpoint (Ollama, OpenRouter, LM Studio, vLLM …)
OPENAI_COMPAT_LABEL=Ollama
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_DEFAULT_MODEL=

# Optional independent "auto review" model that double-checks risky actions.
# Format provider:model, e.g. anthropic:claude-haiku-5-5
AUTO_REVIEW_MODEL=

# ── Web search ────────────────────────────────────────────────
# Built-in SearXNG is used by default. Alternatively use Brave Search API:
BRAVE_API_KEY=

# ── Behaviour ─────────────────────────────────────────────────
TZ=Europe/Stockholm
BROWSER_LANG=sv-SE
MAX_STEPS_PER_RUN=60
WORKER_CONCURRENCY=4
MAX_BOT_CHAIN_DEPTH=5
# Contact for Web Push (required by the push services)
VAPID_SUBJECT=mailto:you@example.com
